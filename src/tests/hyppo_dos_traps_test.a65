getcwd_expected_disk:
        !byte 0

!align 255, 0
filedate_testfilename:
        !text "FDATE.TXT", 0

!align 255, 0
mkdir_dirname:
        !text "MKDTEST", 0

!align 255, 0
mkdir_readdir_area:
        !fill 256, 0

mkdir_fd:
