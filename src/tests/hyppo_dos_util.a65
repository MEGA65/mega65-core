msg_gds_secpercluster:
        !text "SECTORS/CLUSTER: $", 0
msg_gds_clusters:
        !text "TOTAL CLUSTERS: $", 0

msg_gcwd_path:
        !text "CWD PATH: ", 0
msg_gcwd_disk:
        !text "DISK ID: $", 0

msg_fstat_name:
        !text "SHORT NAME: ", 0
msg_fstat_attrib:
        !text "ATTRIBUTES: ", 0
msg_fstat_size:
        !text "SIZE: $", 0
msg_fstat_created:
