# Run after building bin/HICKUP.M65 and src/hyppo/HICKUP.sym.
test "SD completion with no error succeeds"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD3680 $18
jsr sd_rws_checksuccess
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg b
ignore reg sp
ignore reg f
expect flag c is set
check registers
test end

test "SD error with legacy BUSY stuck resets immediately"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD3680 $5A
breakpoint sd_resetsequence
jsr sd_rws_checksuccess
expect pc = sd_resetsequence
ignore reg a
ignore reg x
ignore reg y
ignore reg b
ignore reg sp
ignore reg f
check registers
test end

test "SD completion with an error resets before retry"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD3680 $58
breakpoint sd_resetsequence
jsr sd_rws_checksuccess
expect pc = sd_resetsequence
ignore reg a
ignore reg x
ignore reg y
ignore reg b
ignore reg sp
ignore reg f
check registers
test end
