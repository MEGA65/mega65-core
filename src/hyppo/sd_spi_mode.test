# Run after building bin/HICKUP.M65 and src/hyppo/HICKUP.sym:
# src/tools/hyppotest src/hyppo/sd_spi_mode.test

test "SD mode warning: native 4-bit high speed"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
poke $FFD3686 $0F $00
breakpoint printmessage
breakpoint tryreadmbr
jmp check_sd_bus_mode
assert pc = tryreadmbr
test end

test "SD mode warning: native 4-bit default speed"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
poke $FFD3686 $0B $00
breakpoint printmessage
breakpoint tryreadmbr
jmp check_sd_bus_mode
assert pc = tryreadmbr
test end

test "SD mode warning: native SPI"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
poke $FFD3686 $09 $00
breakpoint printmessage
breakpoint tryreadmbr
jmp check_sd_bus_mode
assert pc = printmessage
test end

