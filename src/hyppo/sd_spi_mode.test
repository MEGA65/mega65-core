test "SD mode warning: native error code"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
poke $FFD3686 $09 $21
breakpoint printmessage
breakpoint tryreadmbr
jmp check_sd_bus_mode
assert pc = tryreadmbr
test end

test "SD mode warning: wait for a fresh keypress"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke screenrow $08
poke $FFD3686 $09 $00
# Model a pending-key count at $C000; the mock consumes one key per call.
poke $C000 $01
poke scankeyboard $AD $00 $C0 $F0 $05 $CE $00 $C0 $18 $60 $38 $60
breakpoint sd_spi_wait_key
breakpoint tryreadmbr
jmp check_sd_bus_mode
assert pc = sd_spi_wait_key
# The boot-time key was drained. Another empty poll must keep waiting.
clear breakpoint sd_spi_wait_key
step 12
breakpoint sd_spi_wait_key
run until brk
assert pc = sd_spi_wait_key
# A new key acknowledges the warning and proceeds to MBR reading.
clear breakpoint sd_spi_wait_key
poke $C000 $01
run until brk
assert pc = tryreadmbr
test end
