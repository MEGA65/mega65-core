test "Boot wait: legacy absent card waits three times"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $1A
poke $C000 $00
poke sdwaitawhile $EE $00 $C0 $60
poke $C100 $AD $00 $C0 $60
jsr sd_wait_for_boot_card
jsr $C100
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is clear
expect a = $03
check registers
test end

test "MBR: reuse healthy 4-bit session"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sd_resetsequence
breakpoint l7
jmp readmbr
expect pc = l7
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is set
check registers
test end

