# Boot polling and MBR session reuse; assemble Hyppo before running.

test "Boot wait: ready native returns without settling delay"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is set
check registers
test end

test "Boot wait: ready SPI fallback returns without settling delay"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $09 $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is set
check registers
test end

test "Boot wait: terminal native error fails immediately"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $5A
breakpoint sdwaitawhile
breakpoint sdreadytest
jsr sd_wait_for_boot_card
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is clear
check registers
test end

test "Boot wait: pending native init polls until ready"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $1A
poke $C000 $00
poke sdreadytest $EE $00 $C0 $AD $00 $C0 $C9 $03 $B0 $02 $18 $60 $A9 $00 $8D $80 $D6 $38 $60
poke $C100 $AD $00 $C0 $60
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
jsr $C100
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is set
expect a = $03
check registers
test end

test "Boot wait: native timeout retains all three windows"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $1A
poke $C000 $00
poke sdreadytest $EE $00 $C0 $A9 $00 $18 $60
poke $C100 $AD $00 $C0 $60
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
jsr $C100
expect pc = $0001
ignore reg a
ignore reg x
ignore reg y
ignore reg z
ignore reg b
ignore reg sp
ignore reg f
expect flag c is clear
expect a = $03
check registers
test end

