# Boot polling and MBR session reuse; assemble Hyppo before running.

test "Boot wait: ready native returns without settling delay"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is set
test end

test "Boot wait: ready SPI fallback returns without settling delay"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $09 $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is set
test end

test "Boot wait: terminal native error fails immediately"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $5A
breakpoint sdwaitawhile
breakpoint sdreadytest
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is clear
test end

test "Boot wait: pending native init polls until ready"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $1A
# BIT and sdreadytest both read status; become ready on the fourth read.
mock read $FFD3680 $1A $1A $1A $18
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is set
assert reads $FFD3680 = $04
test end

test "Boot wait: native timeout retains all three windows"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $1A
# Force each counter window to wrap on its first increment, preserving
# the real sdreadytest and timeout/reset branches.
mock read sdcounter $FF
mock read sdcounter+1 $FF
mock read sdcounter+2 $FF
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is clear
assert reads sdcounter = $03
test end

test "Boot wait: legacy retains settling wait"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = sdwaitawhile
test end

test "Boot wait: older native retains settling wait"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = sdwaitawhile
test end

test "Boot wait: unknown diagnostic version retains settling wait"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $02
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sdwaitawhile
jsr sd_wait_for_boot_card
assert pc = sdwaitawhile
test end

test "Boot wait: legacy absent card waits three times"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $1A
mock read sdcounter $FF
mock read sdcounter+1 $FF
mock read sdcounter+2 $FF
jsr sd_wait_for_boot_card
assert pc = $0001
assert flag c is clear
assert reads sdcounter = $03
test end

test "MBR: reuse healthy 4-bit session"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sd_resetsequence
breakpoint l7
jmp readmbr
assert pc = l7
assert flag c is set
test end

test "MBR: reuse healthy SPI fallback session"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD3680 $18
poke $FFD3686 $09 $00
breakpoint sd_resetsequence
breakpoint l7
jmp readmbr
assert pc = l7
assert flag c is set
test end

test "MBR: reset legacy"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $18
poke $FFD3686 $FE $FF
breakpoint sd_resetsequence
breakpoint l7
jmp readmbr
assert pc = sd_resetsequence
test end

test "MBR: reset older native"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $00 $00
poke $FFD3680 $18
poke $FFD3686 $0F $00
breakpoint sd_resetsequence
breakpoint l7
jmp readmbr
assert pc = sd_resetsequence
test end

