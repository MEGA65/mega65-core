# External-card priority and fallback; assemble Hyppo before running.
# Run real probing/readiness code with scripted controller status.

test "Boot slots: external ready has priority"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
mock read $FFD3680 $18
expect write $FFD3680 $C1 $00 $01
poke printmessage $60
breakpoint check_sd_bus_mode
breakpoint go64
jmp sd_boot_probe_cards
assert pc = check_sd_bus_mode
assert reads $FFD3680 = $02
check writes
test end

test "Boot slots: external failure falls back to internal"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
mock read $FFD3680 $5A $18 $18
expect write $FFD3680 $C1 $00 $01 $C0 $00 $01
poke printmessage $60
breakpoint check_sd_bus_mode
breakpoint go64
jmp sd_boot_probe_cards
assert pc = check_sd_bus_mode
assert reads $FFD3680 = $03
check writes
test end

test "Boot slots: both failed slots continue without SD"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
mock read $FFD3680 $5A
mock read $FFD3687 $01
expect write $FFD3680 $C1 $00 $01 $C0 $00 $01 $C1 $C0
poke printmessage $60
breakpoint check_sd_bus_mode
breakpoint go64
breakpoint sd_noresp_drain_keys
jmp sd_boot_probe_cards
assert pc = go64
assert reads $FFD3680 = $02
assert reads $FFD3687 = $02
check writes
test end


test "Parallel boot: both ready prefers external"
loadhyppo bin/HICKUP.M65
loadhypposymbols src/hyppo/HICKUP.sym
let b = $BF
poke $FFD36CC $53 $01
poke $FFD36D7 $D2
mock read $FFD3680 $18
expect write $FFD3680 $C1 $2B
poke printmessage $60
breakpoint check_sd_bus_mode
breakpoint go64
jmp sd_boot_probe_cards
assert pc = check_sd_bus_mode
assert reads $FFD3680 = $02
check writes
test end


